POSTGRES_USER=ariadne
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ariadne
# Connection string for the API and migrations. Use the same password as above.
DATABASE_URL=postgres://ariadne:change-me@127.0.0.1:5432/ariadne
# Integration tests create this database if it is missing. Its name must end in "_test".
TEST_DATABASE_URL=postgres://ariadne:change-me@127.0.0.1:5432/ariadne_test
# End-to-end tests create, migrate and fill this database. Its name must end in "_e2e".
E2E_DATABASE_URL=postgres://ariadne:change-me@127.0.0.1:5432/ariadne_e2e
# Only for a hosted database: the PEM certificate of its certificate authority, as text,
# not a file path. Leave unset for the local database.
# DATABASE_CA_CERT=
