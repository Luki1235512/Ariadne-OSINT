{
  "printWidth": 100,
  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "importOrder": ["<BUILTIN_MODULES>", "<THIRD_PARTY_MODULES>", "^@ariadne/(.*)$", "^[.]"],
  "importOrderTypeScriptVersion": "6.0.0",
  "overrides": [
    {
      "files": ["*.json", "*.jsonc"],
      "options": { "trailingComma": "none" }
    }
  ]
}
